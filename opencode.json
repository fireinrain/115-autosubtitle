{
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@1.12.0",
          "--autoConnect",
          "--no-usage-statistics",
          "--categoryExtensions",
          "--viewport",
          "1440x900"
        ]
      }
    }
  }
}